{
  "manifest_version": 3,
  "name": "Розсилка великих файлів",
  "description": "Розбиває великий архів на частини та розсилає їх списку адресатів з адресної книги окремими листами.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "bigfile-sender@local.example",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_label": "Розсилка файлів",
    "default_title": "Розсилка великих файлів",
    "default_icon": "icon.svg"
  },
  "permissions": [
    "addressBooks",
    "accountsRead",
    "compose",
    "compose.send"
  ]
}